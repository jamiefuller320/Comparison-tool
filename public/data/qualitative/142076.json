istItemCount":"5"}},{"url":"https://www.tannersbrookpri.org.uk/page/?title=P%2EE&pid=120","finalUrl":"https://www.tannersbrookpri.org.uk/page/?title=P%2EE&pid=120","fetchedAt":"2026-09-20","contentLength":50868,"contentHash":"245de17344edc962d46e0a40f8d8b5c68ebfb8df0d2be98d4bd12f273ba62a54","textHash":"9faf2ab48b0e4e0ea80aa4171223ace9d45038b8c5eb27da22807ff062fca307","pageTitle":"Tanners Brook Primary School - P.E","section":"general","text":"P.E\nThis page is currently awaiting content\nCurriculum Booklet 2024-2025\nProgression Map 2024-2025\nProvision Map 2024-2025\nSchool Payments\nFollow Us!\nGetting Here\nCurriculum Subjects","listItems":["School Payments","Follow Us!","Getting Here","Curriculum Subjects"],"meta":{"pageType":"substantive","sectionCount":"1","listItemCount":"4"}},{"url":"https://www.tannersbrookpri.org.uk/page/?title=Primary+PE+and+Sport+Premium&pid=71","finalUrl":"https://www.tannersbrookpri.org.uk/page/?title=Primary+PE+and+Sport+Premium&pid=71","fetchedAt":"2026-09-20","contentLength":53980,"contentHash":"de1a0fa4699dbf95f77913415fa6feda7403f290df7de4406d27907274bec0fe","textHash":"08cbc647027187e9830df071d4aa5a30fa98f878eebafd29881e9a9ab737acc0","pageTitle":"Tanners Brook Primary School - Primary PE and Sport Premium","section":"enrichment","text":"Primary PE and Sport Premium\nHow we are using the money\nThe Sport Premium is an additional amount of money given to schools in addition to their main budget. Every school receives a fixed amount of money for each pupil. The money is provided to schools so that we can improve the provision of PE and sport and to encourage the development of healthy, active lifestyles.\nThe purpose of the PE and Sport Premium grant is for schools to make additional and sustainable improvements to the provision of PE and sport for the benefit of all primary aged pupils to encourage the development of healthy, active lifestyles.\nWe must report to you the level of Primary PE and Sport Premium, how we have used it and what difference it has made. This year, the school will receive \u00a319,580 in Sport Premium.\nWe are planning to spend the money in the following ways:\nIncreased participation in competitive sport\nFunding allocation\nCategories of grant spending\nOpportunities, impacts and sustainability\nSchool specifics\nSchool Payments\nFollow Us!\nGetting Here\nPrimary PE and Sport Premium","listItems":["Increased participation in competitive sport","School Payments","Follow Us!","Getting Here","Primary PE and Sport Premium"],"meta":{"pageType":"substantive","sectionCount":"1","listItemCount":"5"}}]}