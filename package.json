{
  "name": "schoolside",
  "version": "0.1.0",
  "private": true,
  "description": "Parental-choice school performance comparison for English schools",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "npx --yes serve out",
    "lint": "tsc --noEmit",
    "harvest": "python3 scripts/harvest-schools.py && python3 scripts/enrich-geocode.py",
    "harvest:sample": "python3 scripts/harvest-schools.py --sample 40 && python3 scripts/enrich-geocode.py",
    "geocode": "python3 scripts/enrich-geocode.py",
    "test:postcode": "npx --yes tsx scripts/test-postcode.mjs",
    "test:phases": "npx --yes tsx scripts/test-phases.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
