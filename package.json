{
  "name": "school-compass",
  "version": "0.1.0",
  "private": true,
  "description": "School Compass — parental school shortlist and compare (Hampshire + South East, London, and Dorset packs)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "build:pages:project-path": "GITHUB_PAGES=true GITHUB_PAGES_PROJECT_PATH=true next build",
    "start": "npx --yes serve out",
    "lint": "tsc --noEmit",
    "enrich:websites": "python3 scripts/enrich-school-websites.py --all-packs",
    "harvest": "python3 scripts/harvest-schools.py && python3 scripts/enrich-geocode.py && python3 scripts/enrich-secondaries.py && python3 scripts/enrich-independents.py && python3 scripts/enrich-phonics.py && python3 scripts/harvest-ey-providers.py && python3 scripts/harvest-childminders.py && python3 scripts/enrich-ey-schools.py && python3 scripts/extract-ks2-history.py",
    "harvest:hampshire": "python3 scripts/harvest-schools.py --seed-la && python3 scripts/enrich-geocode.py && python3 scripts/enrich-secondaries.py --seed-la && python3 scripts/enrich-independents.py && python3 scripts/enrich-school-websites.py && python3 scripts/enrich-phonics.py --seed-la && python3 scripts/enrich-admissions-places.py --seed-la && python3 scripts/harvest-hampshire-catchments.py && python3 scripts/harvest-ey-providers.py && python3 scripts/harvest-childminders.py && python3 scripts/enrich-ey-schools.py && python3 scripts/extract-ks2-history.py --seed-la && npm run enrich:precis:hampshire",
    "enrich:admissions": "python3 scripts/enrich-admissions-places.py",
    "harvest:catchments": "python3 scripts/harvest-hampshire-catchments.py",
    "enrich:precis:hampshire": "python3 scripts/enrich-inspection-precis.py --limit 250 && python3 scripts/enrich-inspection-precis.py --ey --limit 120 && python3 scripts/enrich-inspection-precis.py --childminders --limit 80",
    "harvest:sample": "python3 scripts/harvest-schools.py --sample 40 && python3 scripts/enrich-geocode.py && python3 scripts/enrich-secondaries.py && python3 scripts/enrich-independents.py && python3 scripts/enrich-phonics.py && python3 scripts/harvest-ey-providers.py && python3 scripts/harvest-childminders.py && python3 scripts/enrich-ey-schools.py",
    "trim:hampshire": "python3 scripts/trim-index-to-seed-la.py",
    "geocode": "python3 scripts/enrich-geocode.py",
    "enrich:secondaries": "python3 scripts/enrich-secondaries.py",
    "enrich:independents": "python3 scripts/enrich-independents.py",
    "enrich:phonics": "python3 scripts/enrich-phonics.py",
    "enrich:ey-schools": "python3 scripts/enrich-ey-schools.py",
    "enrich:precis": "python3 scripts/enrich-inspection-precis.py",
    "enrich:qualitative": "python3 scripts/enrich-qualitative.py --require-website",
    "synthesize:qualitative": "python3 scripts/synthesize-qualitative.py",
    "qa:qualitative": "python3 scripts/qa-qualitative.py",
    "publish:qualitative": "python3 scripts/publish-qualitative-shards.py",
    "loop:qualitative": "python3 scripts/run-qualitative-loop.py --scope parallel --parallel-las \"Dorset|East Sussex\" --include-seed --advance-streams",
    "loop:qualitative-quality": "python3 scripts/run-qualitative-quality-loop.py",
    "report:qualitative": "python3 scripts/report-qualitative-coverage.py",
    "test:qualitative-loop": "python3 scripts/test-qualitative-loop.py && python3 scripts/test_stream_advance.py",
    "test:qualitative-quality-loop": "python3 scripts/test-qualitative-quality-loop.py && python3 scripts/test_learning_trigger.py",
    "test:qualitative-load": "npx --yes tsx scripts/test-qualitative-load.mjs",
    "test:ensure-area-coverage": "npx --yes tsx scripts/test-ensure-area-coverage.mjs",
    "enrich:contacts": "python3 scripts/enrich-contacts.py --require-website",
    "report:pack-quality": "python3 scripts/report-pack-quality.py",
    "polish:pack-quality": "python3 scripts/polish-pack-quality.py",
    "loop:pack-quality": "python3 scripts/run-pack-quality-loop.py",
    "test:pack-quality-loop": "python3 scripts/test-pack-quality-loop.py",
    "report:seo-coverage": "python3 scripts/report-seo-coverage.py",
    "loop:seo-coverage": "python3 scripts/run-seo-coverage-loop.py",
    "test:seo-coverage-loop": "python3 scripts/test-seo-coverage-loop.py",
    "test:seo-schools": "npx --yes tsx scripts/test-seo-schools.mjs",
    "harvest:ey": "python3 scripts/harvest-ey-providers.py && python3 scripts/harvest-childminders.py && python3 scripts/enrich-ey-schools.py",
    "harvest:childminders": "python3 scripts/harvest-childminders.py",
    "history:ks2": "python3 scripts/extract-ks2-history.py",
    "pack:la": "python3 scripts/build-la-pack.py",
    "pack:southeast": "python3 scripts/build-region-packs.py --skip-ready --continue-on-error",
    "pack:london": "python3 scripts/build-region-packs.py --london-only --skip-ready --continue-on-error",
    "pack:southeast:complete": "python3 scripts/complete-region-soft-launch.py",
    "test:pack-depth": "python3 scripts/test-pack-depth.py",
    "test:phonics": "npx --yes tsx scripts/test-phonics.mjs",
    "test:tour": "npx --yes tsx scripts/test-tour.mjs",
    "test:seed-scope": "npx --yes tsx scripts/test-seed-scope.mjs",
    "test:ey": "npx --yes tsx scripts/test-ey.mjs",
    "test:childminders": "npx --yes tsx scripts/test-childminders.mjs",
    "test:visit-pack": "npx --yes tsx scripts/test-visit-pack.mjs",
    "test:print-pack-metrics": "npx --yes tsx scripts/test-print-pack-metrics.mjs",
    "test:print-visit-pack": "npx --yes tsx scripts/test-print-visit-pack.mjs",
    "test:decision-guidance": "npx --yes tsx scripts/test-decision-guidance.mjs",
    "test:postcode": "npx --yes tsx scripts/test-postcode.mjs",
    "test:nearby": "npx --yes tsx scripts/test-nearby.mjs",
    "test:catchments": "npx --yes tsx scripts/test-catchments.mjs",
    "test:admissions-places": "npx --yes tsx scripts/test-admissions-places.mjs",
    "test:phases": "npx --yes tsx scripts/test-phases.mjs",
    "test:sectors": "npx --yes tsx scripts/test-sectors.mjs",
    "test:indie-sanitize": "python3 scripts/test-indie-sanitize.py",
    "test:inspection-precis": "python3 scripts/test-inspection-precis.py",
    "test:qualitative-evidence": "npx --yes tsx scripts/test-qualitative-evidence.mjs && cd tools/school-capture && python3 -m pytest -q",
    "test:inspection-highlights": "npx --yes tsx scripts/test-inspection-highlights.mjs",
    "test:content-review": "npx --yes tsx scripts/test-content-review.mjs",
    "test:resilient-fetch": "npx --yes tsx scripts/test-resilient-fetch.mjs",
    "test:collate-indexes": "npx --yes tsx scripts/test-collate-indexes.mjs",
    "test:headlines": "npx --yes tsx scripts/test-headlines.mjs",
    "test:ks2-history": "npx --yes tsx scripts/test-ks2-history.mjs && python3 scripts/test-extract-ks2-history.py",
    "test:compare-paths": "npx --yes tsx scripts/test-compare-paths.mjs",
    "test:binder-framework": "npx --yes tsx scripts/test-binder-framework.mjs",
    "test:school-column-header": "npx --yes tsx scripts/test-school-column-header.mjs",
    "test:source-stamp": "npx --yes tsx scripts/test-source-stamp.mjs",
    "test:data-gaps": "npx --yes tsx scripts/test-data-gaps.mjs",
    "test:coverage-strip": "npx --yes tsx scripts/test-coverage-strip.mjs",
    "test:school-links": "npx --yes tsx scripts/test-school-links.mjs",
    "test:sector-benches": "python3 scripts/test-sector-benches.py",
    "test:la-packs": "npx --yes tsx scripts/test-la-packs.mjs",
    "test:ui-preferences": "npx --yes tsx scripts/test-ui-preferences.mjs",
    "test:account": "npx --yes tsx scripts/test-account.mjs",
    "test:share-comparison": "npx --yes tsx scripts/test-share-comparison.mjs",
    "test:provision-nav": "npx --yes tsx scripts/test-provision-nav.mjs",
    "test:product-feedback": "npx --yes tsx scripts/test-product-feedback.mjs",
    "backup:weekly": "python3 scripts/code_data_backup.py snapshot --include-git",
    "test:backup": "python3 scripts/test-code-data-backup.py",
    "digest:feedback": "python3 scripts/digest-product-feedback.py",
    "qa:human-flags": "python3 scripts/record-human-qa-flags.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
